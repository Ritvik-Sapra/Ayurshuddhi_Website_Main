# Copy to .env.local and fill in. Every key is optional; the site runs without them
# (form endpoints validate and log only).

# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email delivery for bookings and contact messages (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Spam protection (https://developers.cloudflare.com/turnstile/)
TURNSTILE_SECRET_KEY=

# Lead storage (https://supabase.com)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Development only: delay content loading (ms) so loading skeletons are visible.
SKELETON_DEMO_DELAY_MS=
